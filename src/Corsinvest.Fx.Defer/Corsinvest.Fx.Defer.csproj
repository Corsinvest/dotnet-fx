<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Package Information (unique to this package) -->
    <PackageId>Corsinvest.Fx.Defer</PackageId>
    <Title>Go-style defer for C#</Title>
    <Description>Go-style defer for C#: run a cleanup action when the scope exits, written next to the thing it undoes. For cleanup that is not a Dispose() - restoring state, balancing counters, Begin/End pairs on APIs that never implemented IDisposable. Async defers return IAsyncDisposable, so the compiler enforces 'await using' and blocking a thread on an async cleanup cannot reach runtime.</Description>
    <PackageTags>defer;go;cleanup;dispose;scope;resource-management;async;lifo;zig;swift;await-using</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Version inherited from Directory.Build.props -->

    <!-- Auto Global Usings Configuration -->
    <EnableDeferGlobalUsings Condition="'$(EnableDeferGlobalUsings)' == ''">true</EnableDeferGlobalUsings>
  </PropertyGroup>

  <!--
    Ship the global using to consumers. A <GlobalUsing> item applies only to the project declaring
    it, so the one that used to sit here never reached anyone referencing the package.
  -->
  <ItemGroup>
    <!-- build\ covers a direct reference, buildTransitive\ a transitive one. -->
    <None Include="build\Corsinvest.Fx.Defer.props" Pack="true" PackagePath="build\;buildTransitive\" />
  </ItemGroup>

</Project>