<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>

    <!-- Test project overrides -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS1591;xUnit1051</NoWarn>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>


    <!-- xunit.v3 4.x runs on Microsoft.Testing.Platform; VSTest is gone in the .NET 10 SDK -->

    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.7.0" />
    <!-- Needed to exercise the code fix provider (AdhocWorkspace, Formatter, CodeAction) -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.7.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Functional\Corsinvest.Fx.Functional\Corsinvest.Fx.Functional.csproj" />
    <!-- Reference generator both as Analyzer and as Assembly for testing -->
    <ProjectReference Include="..\..\..\src\Functional\Corsinvest.Fx.Functional.Generators\Corsinvest.Fx.Functional.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\src\Functional\Corsinvest.Fx.Functional.Generators\Corsinvest.Fx.Functional.Generators.csproj" ReferenceOutputAssembly="true" />
    <!-- As an assembly, so the tests can instantiate the provider directly... -->
    <ProjectReference Include="..\..\..\src\Functional\Corsinvest.Fx.Functional.CodeFixes\Corsinvest.Fx.Functional.CodeFixes.csproj" ReferenceOutputAssembly="true" />
    <!-- ...and as an analyzer, so the fix is offered in the IDE while writing tests. -->
    <ProjectReference Include="..\..\..\src\Functional\Corsinvest.Fx.Functional.CodeFixes\Corsinvest.Fx.Functional.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
