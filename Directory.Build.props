<Project>
  <!--
    Corsinvest.Fx - Centralized Build Properties
    All common settings, versioning, and metadata for NuGet packages
  -->

  <!-- Common build settings for all projects -->
  <PropertyGroup>
    <!-- Default TargetFramework for most projects (CompileTime projects excluded - they require .NET 9+) -->
    <TargetFramework Condition="'$(TargetFramework)' == '' AND '$(TargetFrameworks)' == '' AND !$(MSBuildProjectName.Contains('CompileTime'))">net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Build quality settings -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1605</WarningsNotAsErrors>
    <NoWarn>CS1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <PublishDocumentationFile>true</PublishDocumentationFile>
  </PropertyGroup>

  <!-- Versioning (Default for all packages) -->
  <PropertyGroup>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>

  <!-- Package metadata (common across all packages) -->
  <PropertyGroup>
    <Authors>Corsinvest</Authors>
    <Company>Corsinvest</Company>
    <Product>Corsinvest.Fx</Product>
    <Copyright>Copyright © Corsinvest $([System.DateTime]::Now.Year)</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Corsinvest/dotnet-fx</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Corsinvest/dotnet-fx.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageIcon>icon.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>2.0.0 is a breaking change: the [Union]/[Union&lt;T1..T8&gt;] attributes are removed in favor of the IUnion&lt;T1..T8&gt; marker interface. See "Migrating from 1.x" in https://github.com/Corsinvest/dotnet-fx/blob/master/src/Functional/Corsinvest.Fx.Functional/docs/Union.md#migrating-from-1x</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Package content (icon) - if exists at solution root -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Condition="Exists('$(MSBuildThisFileDirectory)icon.png')" />
  </ItemGroup>
</Project>